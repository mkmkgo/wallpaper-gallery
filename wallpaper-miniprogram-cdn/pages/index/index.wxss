page {
  background-color: #0c0c0c;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, scroll-view {
  box-sizing: border-box;
}

image {
  background-color: #1a1a1a;
}

.page {
  background-color: #0c0c0c;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 0 16rpx;
  background: transparent;
}

.header-inner {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
}

.collection-section {
  padding: 24rpx 0 28rpx;
}

.collection-scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}

.collection-list {
  display: inline-flex;
  gap: 24rpx;
}

.collection-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 380rpx;
  flex-shrink: 0;
}

.collection-card:active {
  opacity: 0.85;
}

.collection-img {
  width: 320rpx;
  height: 240rpx;
  border-radius: 16rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
}

.collection-glass {
  width: 380rpx;
  margin-top: -120rpx;
  padding-top: 128rpx;
  padding-bottom: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.collection-name {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

.quick-nav {
  padding: 0 16rpx 24rpx;
}

.quick-nav-scroll {
  white-space: nowrap;
}

.quick-nav-list {
  display: inline-flex;
  gap: 16rpx;
}

.quick-nav-item {
  display: inline-flex;
}

.quick-nav-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid;
  transition: opacity 0.2s;
}

.quick-nav-pill:active {
  opacity: 0.7;
}

.quick-nav-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.quick-nav-text {
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}

.latest-section {
  padding: 0 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.section-more {
  padding: 8rpx 0;
}

.section-more-text {
  font-size: 24rpx;
  color: #666;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 16rpx;
}

.skeleton-card {
  width: calc(33.33% - 12rpx);
}

.skeleton-image {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background-color: #1a1a1a;
}

.shimmer {
  background: linear-gradient(90deg, #1a1a1a 25%, #222 50%, #1a1a1a 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

.empty-text {
  color: #444;
  font-size: 28rpx;
}

.latest-scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}

.latest-list {
  display: inline-flex;
  gap: 12rpx;
}

.latest-card {
  display: inline-flex;
  width: 240rpx;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.latest-card:active {
  opacity: 0.85;
}

.latest-image {
  width: 100%;
  height: 100%;
}

.desktop-list {
  display: inline-flex;
  gap: 12rpx;
}

.desktop-card {
  display: inline-flex;
  width: 340rpx;
  height: 210rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.desktop-card:active {
  opacity: 0.85;
}

.desktop-image {
  width: 100%;
  height: 100%;
}

.loading-tip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  margin: 0 16rpx 24rpx;
  background: rgba(255, 71, 87, 0.08);
  border: 1rpx solid rgba(255, 71, 87, 0.15);
  border-radius: 16rpx;
}

.loading-tip-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.loading-tip-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 71, 87, 0.2);
  border-top-color: #ff4757;
  border-radius: 50%;
  animation: tipSpin 0.8s linear infinite;
}

@keyframes tipSpin {
  to { transform: rotate(360deg); }
}

.loading-tip-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.5rpx;
  line-height: 1.5;
}

.disclaimer-section {
  padding: 48rpx 16rpx 24rpx;
}

.disclaimer-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.disclaimer-divider {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.06);
}

.disclaimer-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
}

.disclaimer-btn:active {
  opacity: 0.7;
}

.disclaimer-shield {
  width: 24rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shield-body {
  width: 20rpx;
  height: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 3rpx 3rpx 10rpx 10rpx;
  position: relative;
}

.shield-body::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-top: none;
  border-radius: 0 0 2rpx 2rpx;
}

.disclaimer-btn-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 1rpx;
}

.disclaimer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.disclaimer-modal {
  width: 620rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(60px);
  -webkit-backdrop-filter: blur(60px);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.disclaimer-modal-header {
  margin-bottom: 28rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.disclaimer-shield-lg {
  width: 48rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shield-body-lg {
  width: 40rpx;
  height: 48rpx;
  border: 3rpx solid rgba(255, 71, 87, 0.5);
  border-radius: 5rpx 5rpx 20rpx 20rpx;
  position: relative;
}

.shield-body-lg::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 16rpx;
  border: 3rpx solid rgba(255, 71, 87, 0.5);
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
}

.disclaimer-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.disclaimer-modal-body {
  max-height: 520rpx;
  margin-bottom: 32rpx;
}

.disclaimer-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.8;
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.disclaimer-text:last-child {
  margin-bottom: 0;
}

.disclaimer-contact {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.disclaimer-contact-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.disclaimer-contact-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.disclaimer-contact-btn::after {
  border: none;
}

.contact-btn-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background: rgba(255, 71, 87, 0.1);
  border: 1rpx solid rgba(255, 71, 87, 0.2);
  border-radius: 30rpx;
}

.contact-icon {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid rgba(255, 71, 87, 0.6);
  border-radius: 50%;
  position: relative;
}

.contact-icon::after {
  content: "";
  position: absolute;
  bottom: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 6rpx;
  border: 2rpx solid rgba(255, 71, 87, 0.6);
  border-top: none;
  border-radius: 0 0 10rpx 10rpx;
}

.contact-btn-text {
  font-size: 22rpx;
  color: #ff6b81;
  letter-spacing: 0.5rpx;
}

.disclaimer-modal-footer {
  display: flex;
  justify-content: center;
}

.disclaimer-confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 44rpx;
  padding: 20rpx 80rpx;
}

.disclaimer-confirm-btn:active {
  opacity: 0.7;
}

.disclaimer-confirm-text {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}
