# pnpm 12 对 esbuild 等包的构建脚本默认跳过（IGNORED_BUILDS），
# 显式放行本项目需要的构建脚本（CI 用 pnpm 9 无此策略，此文件仅影响本机）
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=@parcel/watcher
onlyBuiltDependencies[]=vue-demi
onlyBuiltDependencies[]=puppeteer

# 本机网络访问 npm registry 不稳定，跳过每次运行脚本前的依赖校验，
# 依赖变更后手动执行 pnpm install 即可
verify-deps-before-run=false
